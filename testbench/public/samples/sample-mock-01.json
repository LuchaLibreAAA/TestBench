        {
          "id": "q9", "type": "multi", "topic": "Vectors",
          "text": { "en": "Select all vector quantities from the following:" },
          "options": [
            { "id": "a", "text": { "en": "Velocity" } },
            { "id": "b", "text": { "en": "Speed" } },
            { "id": "c", "text": { "en": "Force" } },
            { "id": "d", "text": { "en": "Mass" } }
          ],
          "answer": ["a", "c"],
          "explanation": { "en": "Velocity and Force are vector quantities (they have both magnitude and direction). Speed and Mass are scalar quantities." }
        },
        {
          "id": "q10", "type": "multi", "topic": "Thermodynamics",
          "text": { "en": "Which of the following are state functions?" },
          "options": [
            { "id": "a", "text": { "en": "Internal energy" } },
            { "id": "b", "text": { "en": "Work" } },
            { "id": "c", "text": { "en": "Entropy" } },
            { "id": "d", "text": { "en": "Heat" } }
          ],
          "answer": ["a", "c"],
          "explanation": { "en": "Internal energy and entropy are state functions. Work and heat are path functions." }
        }
      ]
    }
