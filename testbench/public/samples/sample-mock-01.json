      "id": "phy-a",
      "name": { "en": "Physics A (MCQ)" },
      "marking": { "correct": 4, "wrong": -1, "unattempted": 0 },
      "questions": [
        {
          "id": "q1", "type": "single", "topic": "Kinematics",
          "text": { "en": "If $v = 3t^2$, the acceleration at $t = 2$ is:" },
          "options": [
            { "id": "a", "text": { "en": "6 m/s²" } },
            { "id": "b", "text": { "en": "12 m/s²" } },
            { "id": "c", "text": { "en": "18 m/s²" } },
            { "id": "d", "text": { "en": "24 m/s²" } }
          ],
          "answer": ["b"],
          "explanation": { "en": "$a = \\frac{dv}{dt} = 6t$. At $t = 2$, $a = 12$ m/s²." }
        },
        {
          "id": "q2", "type": "single", "topic": "Laws of Motion",
          "text": { "en": "A body of mass 5 kg is acted upon by two perpendicular forces 12 N and 5 N. The acceleration of the body is:" },
          "options": [
            { "id": "a", "text": { "en": "2.6 m/s²" } },
            { "id": "b", "text": { "en": "3.4 m/s²" } },
            { "id": "c", "text": { "en": "1.0 m/s²" } },
            { "id": "d", "text": { "en": "0.5 m/s²" } }
          ],
          "answer": ["a"],
          "explanation": { "en": "Resultant $F = \\sqrt{12^2 + 5^2} = 13$ N. $a = F/m = 13/5 = 2.6$ m/s²." }
        },
        {
          "id": "q3", "type": "single", "topic": "Work Energy",
          "text": { "en": "A ball is thrown vertically upward. At the highest point:" },
          "options": [
            { "id": "a", "text": { "en": "Both velocity and acceleration are zero" } },
            { "id": "b", "text": { "en": "Velocity is zero but acceleration is non-zero" } },
            { "id": "c", "text": { "en": "Velocity is non-zero but acceleration is zero" } },
            { "id": "d", "text": { "en": "Both velocity and acceleration are non-zero" } }
          ],
          "answer": ["b"],
          "explanation": { "en": "At the highest point, velocity is zero but gravitational acceleration ($g$) still acts downward." }
        },
        {
          "id": "q4", "type": "single", "topic": "Gravitation",
          "text": { "en": "If the radius of the Earth is reduced by 1% keeping mass constant, then the acceleration due to gravity on the surface:" },
          "options": [
            { "id": "a", "text": { "en": "Decreases by 2%" } },
            { "id": "b", "text": { "en": "Increases by 2%" } },
            { "id": "c", "text": { "en": "Decreases by 1%" } },
            { "id": "d", "text": { "en": "Increases by 1%" } }
          ],
          "answer": ["b"],
          "explanation": { "en": "$g = GM/R^2$. If $R$ decreases by 1%, $g$ increases by approximately 2%." }
        },
        {
          "id": "q5", "type": "single", "topic": "Oscillations",
          "text": { "en": "The time period of a simple pendulum of length $l$ on the surface of the moon (where $g_{moon} = g/6$) is:" },
          "options": [
            { "id": "a", "text": { "en": "$T$" } },
            { "id": "b", "text": { "en": "$\\sqrt{6}\\,T$" } },
            { "id": "c", "text": { "en": "$T/\\sqrt{6}$" } },
            { "id": "d", "text": { "en": "$6T$" } }
          ],
          "answer": ["b"],
          "explanation": { "en": "$T = 2\\pi\\sqrt{l/g}$. If $g$ becomes $g/6$, $T' = 2\\pi\\sqrt{6l/g} = \\sqrt{6}\\,T$." }
        }
      ]
    },
